# Copy this file to .env.local (gitignored) and fill in your values.
# Both variables are safe to ship in the client bundle — they're protected
# at the database layer by Row-Level Security policies. Never commit the
# Supabase service_role key.

# Supabase project URL — e.g. https://abcdefghijk.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon / publishable key — starts with "eyJ..." or "sb_publishable_..."
# Find it under: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
